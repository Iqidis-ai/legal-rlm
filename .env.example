# Irys RLM Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED - API Keys
# =============================================================================

# Google Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# REQUIRED FOR PRODUCTION - S3 Configuration
# =============================================================================

# S3 bucket name for document storage
S3_BUCKET=your-bucket-name

# AWS region
S3_REGION=us-east-1

# AWS Credentials (leave blank to use IAM role on EC2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# =============================================================================
# OPTIONAL - Server Configuration
# =============================================================================

# Server settings
IRYS_HOST=0.0.0.0
IRYS_PORT=8000
IRYS_WORKERS=1
IRYS_DEBUG=false

# Logging
IRYS_LOG_LEVEL=INFO
IRYS_LOG_FORMAT=json

# =============================================================================
# OPTIONAL - Resource Limits (tune for your instance size)
# =============================================================================

# Maximum concurrent investigation jobs
IRYS_MAX_CONCURRENT_JOBS=3

# Maximum documents per investigation
IRYS_MAX_DOCS_PER_JOB=50

# Maximum single document size (MB)
IRYS_MAX_DOC_SIZE_MB=10

# Temp storage limit (MB) - important for small instances
IRYS_MAX_TEMP_SIZE_MB=500

# Cleanup temp files after (seconds)
IRYS_CLEANUP_SECONDS=300

# Request timeout (seconds)
IRYS_TIMEOUT_SECONDS=300

# Temp directory (use /tmp for EC2)
IRYS_TEMP_DIR=/tmp/irys

# =============================================================================
# OPTIONAL - Storage Mode
# =============================================================================

# Storage mode for file uploads:
# - "local": Files stored on VM disk (for development/testing)
# - "s3": Files streamed to S3 (for production, keeps VM light)
IRYS_STORAGE_MODE=s3

# =============================================================================
# OPTIONAL - API Security
# =============================================================================

# Secret key for API authentication (optional)
# API_SECRET_KEY=your_secret_key_here

# =============================================================================
# Knowledge Graph Configuration
# =============================================================================

# Active environment: "development" | "staging" | "production"
APP_ENV=development

# Database URLs per environment (set the ones you need)
development_POSTGRES_URL=postgresql://user:pass@dev-host:5432/db?sslmode=require
# staging_POSTGRES_URL=postgresql://user:pass@staging-host:5432/db?sslmode=require
# production_POSTGRES_URL=postgresql://user:pass@prod-host:5432/db?sslmode=require

# Pipeline tuning
GEMINI_REQUESTS_PER_MINUTE=60
GEMINI_MAX_PARALLEL_WORKERS=6
MAX_DOWNLOAD_PARALLEL=6
