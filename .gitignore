# Irys RLM - Git Ignore File
# Prevents sensitive data and temporary files from being committed

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
env/
venv/
ENV/
env.bak/
venv.bak/

# Environment variables and secrets
.env
.env.local
.env.*.local
*.key
*.pem
secrets/
credentials/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.code-workspace

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
*.cover
.hypothesis/
.pytest_cache/
nosetests.xml
coverage.xml
*.coveragerc

# Logs
*.log
logs/
*.log.*

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# Temporary files
*.tmp
*.temp
*.bak
*.swp
.~*

# Cache directories
.cache/
__pypackages__/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Test documents (optional - uncomment if you don't want to commit test files)
# test_documents/

# Output files
output/
results/
investigations/
*.pdf
*.docx

# Gradio temporary files
gradio_cached_examples/
flagged/

# Database files
*.db
*.sqlite
*.sqlite3

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Deployment configs (server-specific)
nginx-*.conf
!nginx.conf.example
*.service
docker-compose.override.yml

# Virtual environment
.venv/


# Codex review artifacts (consumed, never version-controlled).
# Catch-all patterns so future autonomous passes can't accidentally
# commit scratch. Keep local only.
codex_*.txt
codex_*.md
codex_*/
.codex_*.txt
.codex_*.md
.codex_*/
.codex-*/
REVIEW_FINDINGS.md
.audit_tmp/
.benchmarks/
.pytest-tmp/
.tmp_pytest/
tmp[0-9a-z]*/
.claude/scheduled_tasks.lock
experiments/
workspace/

# Agentic / internal process docs — live planning artifacts that stay
# local so the tracked repo is a clean minimum-entropy surface for
# future agents. Extend this list whenever a new DESIGN / SPEC is
# created by an agent session.
.claude/
IDEAL_PRODUCT_SPEC.md
SYSTEM_STATE.md
DECISIONS.md
ASSUMPTIONS.md
enhancements.txt
ENHANCEMENT_DESIGN.md
CONSOLIDATED_IMPLEMENTATION_SPEC.md
CONTRACT_SYNC_ADDENDUM.md
ATTORNEY_WORKFLOW_UX_SPEC.md
BACKGROUND_MAINTENANCE_DESIGN.md
CORE_ALGORITHMS_DESIGN.md
ERROR_HANDLING_RESILIENCE_SAFETY_DESIGN.md
MIGRATION_BACKFILL_DESIGN.md
PROMPT_ENGINEERING_SUBSTRATE.md
TRUST_PRIVILEGE_DISPUTE_INTERACTIONS.md
